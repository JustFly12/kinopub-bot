{
  "name": "kinopub-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Private Telegram bot for KinoPub device activation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "devices": "tsx src/index.ts devices",
    "auth:login": "tsx src/index.ts login"
  },
  "dependencies": {
    "grammy": "^1.38.0",
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
